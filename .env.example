# Copy to .env and fill in. Never commit .env.

# --- Doubao Realtime 3.0 duplex (volcano /ws path)
# New console (recommended): single API Key → request header X-Api-Key
DOUBAO_API_KEY=
# Legacy console fallback: App ID + Access Token (NOT the same value as DOUBAO_API_KEY)
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
# Optional: duplex 3.0 server semantic VAD (default true in config.json)
# DOUBAO_DUPLEX_SERVER_VAD=true
# DOUBAO_END_SMOOTH_WINDOW_MS=1500
ASR_APP_ID=
ASR_ACCESS_KEY=

# --- Follow-up LLM provider: kimi | eas | bailian (optional; overrides config.json followup.active)
# FOLLOWUP_PROVIDER=kimi

# Kimi (Moonshot), when active provider is kimi
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k2-turbo-preview

# Aliyun PAI-EAS, when active provider is eas
EAS_API_BASE=
EAS_API_KEY=
EAS_MODEL=qwen3.5-2b

# Optional: JSON merged over config.json eas.extra_body (e.g. Qwen chat_template_kwargs)
# EAS_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Aliyun Bailian (DashScope), when active provider is bailian
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen3.5-35b-a3b
# Optional: JSON merged over config.json bailian.extra_body
# DASHSCOPE_EXTRA_BODY={"reasoning":{"effort":"medium"}}

# Generic overrides (used if still empty after config + provider env); see followup_client.FollowupQuestionClient
# FOLLOWUP_API_BASE=
# FOLLOWUP_API_KEY=
# FOLLOWUP_MODEL=
# Optional: force API style regardless of provider: chat_completions | responses
# FOLLOWUP_API_STYLE=

# --- VAD (default: Pipecat Smart Turn v3 in-process; used by t2sbg + t2sbg-omni)
VAD_PROVIDER=smart_turn_v3
# Force turn end after sustained silence when semantic EOU rejects (seconds; 0 = off):
# VAD_SILENCE_FORCE_SECS=1.0
# Switch to LiveKit turn-detector (Silero VAD + local SenseVoice STT + livekit/turn-detector EOU):
# VAD_PROVIDER=livekit_turn_detector
# Default local STT (CPU, no cloud keys):
# LIVEKIT_TURN_STT=funasr
# LIVEKIT_TURN_STT=volc
# FUNASR_MODEL=iic/SenseVoiceSmall
# FUNASR_LANGUAGE=zh
# FUNASR_DEVICE=cpu
# FUNASR_HUB=ms
# FUNASR_PARTIAL_INTERVAL_SEC=0.45
# Optional cloud STT (LiveKit Cloud Inference; requires LIVEKIT_API_KEY + LIVEKIT_API_SECRET):
# LIVEKIT_TURN_STT=livekit_inference
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_TURN_LANGUAGE=zh
# LIVEKIT_TURN_THRESHOLD=0.004
# LIVEKIT_TURN_EMBEDDED_ASR=true
# LiveKit turn-detector model (HF timeout? use mirror + local dir):
# HF_ENDPOINT=https://hf-mirror.com
# LIVEKIT_TURN_MODEL_DIR=./models/livekit-turn-detector
# LIVEKIT_TURN_LOCAL_ONLY=1
# Omni only: OMNI_VAD=server to use DashScope server_vad instead of local VAD
# OMNI_VAD=smart_turn_v3
# DashScope WSS: default IPv4 (inet4) — some networks hang on IPv6 handshake
# OMNI_WS_FAMILY=inet4
# OMNI_WS_OPEN_TIMEOUT=20

# Self-deployed Omni websocket (used when /t2sbg-omni selects 自部署 Omni)
# SELF_OMNI_WS_URL=wss://your-ngrok-or-internal-host

# Hush denoise (t2sbg + t2sbg-omni; weya-ai/hush ONNX + libweya_nc; see scripts/download_hush_assets.sh)
# OMNI_HUSH_ENABLED=true
# HUSH_LIB_PATH=third_party/hush/lib/libweya_nc.so
# HUSH_MODEL_PATH=third_party/hush/models/advanced_dfnet16k_model_best_onnx.tar.gz
# HUSH_ATTEN_LIM_DB=100.0
# SMART_TURN_MODEL_PATH=
# SMART_TURN_CPU_COUNT=1
# SMART_TURN_SILERO_STOP_SECS=0.2

# --- Duplug VAD legacy (VAD_PROVIDER=duplug); env overrides config.json vad.*
DUPLUG_VAD_ENABLED=false
DUPLUG_VAD_URL=ws://127.0.0.1:7997/turn

# --- 合作方外呼 API（POST /api/v1/calls，催授权场景）
# PARTNER_API_KEY=                       # 空=开发放行；生产请设置
# OUTBOUND_DRY_RUN=true                  # true=只建任务、不打真电话（联调推荐）
# OUTBOUND_EXPOSE_PROMPT=false           # true 时允许 GET /api/v1/calls/{id}/prompt 看剧本

# --- 容联云 RLCC 呼叫中心 (/call-center + 外呼实拨)
# RLCC_ENABLED=true
# RLCC_API_BASE=https://your-tenant.acloudcc.com
# RLCC_URL_3CS=https://your-tenant.acloudcc.com/3cs
# RLCC_COMPANY_ID=
# RLCC_ABBREVIATE=
# RLCC_OPERATOR_ID=
# RLCC_CONNECTOR_USERNAME=10001@abbreviate
# RLCC_CONNECTOR_PASSWORD=
# RLCC_ADMIN_ACCOUNT=
# RLCC_ADMIN_PASSWORD=
# RLCC_CALLBACK_BASE_URL=https://your-public-host
# RLCC_SDK_BASE_URL=https://cc.yuntongxun.com/ccc/public/cc_sdk
# RLCC_FORKSTREAM_ENABLED=false
