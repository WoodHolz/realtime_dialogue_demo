  "user": "没有别的了，可以结束了。",
  "expect": {
    "must_any": ["再见", "打扰您了", "感谢", "配合"],
    "must_not_any": ["竞业", "保密协议", "再确认一下签署", "系统登记"],
    "no_markdown": true,
    "max_questions": 0,
    "prefer_stop": true
  }
}
