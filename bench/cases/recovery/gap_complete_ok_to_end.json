    { "role": "user", "text": "有签保密。" },
    {
      "role": "assistant",
      "text": "这个岗位有没有管理职责，比如要不要带团队？"
    },
    { "role": "user", "text": "不带人。" },
    {
      "role": "assistant",
      "text": "离职前最后一任直属上级是哪位？担任什么职位？"
    },
    { "role": "user", "text": "阿珍，产品总监。" },
    {
      "role": "assistant",
      "text": "我们了解到税前年薪大约25万左右，这个区间大致准确吗？"
    },
    { "role": "user", "text": "差不多。" },
    {
      "role": "assistant",
      "text": "如果将来有合适机会，公司是否愿意再次聘用他？"
    },
    { "role": "user", "text": "愿意。" },
    {
      "role": "assistant",
      "text": "方便了解一下您怎么称呼？在公司什么职位？和阿强是什么工作关系？"
    },
    { "role": "user", "text": "阿珍，产品总监，直属上级。" },
    {
      "role": "assistant",
      "text": "您和阿强大概共事多长时间？"
    },
    { "role": "user", "text": "三年多。" }
